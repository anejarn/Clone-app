// Data model: docs/architecture.md §5. The first four models are the tables Better Auth expects.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Organizations ----------

/// A property manager using the app. Sigma is the first; every business row belongs to exactly one (V3 prepares
/// other concierges). What is specific to one manager (commission, partners, catalogue, brand) lives here.
model Organization {
  id                    String   @id @default(cuid())
  name                  String
  /// The public site shows the catalogue of the organization named by SIGMA_ORG_SLUG (default "sigma").
  slug                  String   @unique
  /// Default owner commission, in basis points (2000 = 20 %).
  defaultCommissionBps  Int      @default(2000)
  /// Default check-in and check-out times of the organization's homes, in minutes after local midnight
  /// (900 = 15:00, 660 = 11:00); a listing can override them. They place the generated field tasks (Opérations).
  checkInMinutes        Int      @default(900)
  checkOutMinutes       Int      @default(660)
  /// The conciergerie's contact shown to guests in the welcome guide (sticky bar « Appeler » / « WhatsApp »), in
  /// international format (+212…). Null = not shown.
  conciergePhone        String?
  conciergeWhatsapp     String?
  /// Days the travellers' identity data (fiches de police, document scans) of a stay is kept after its departure,
  /// then deleted by the purge job (lib/server/declarations/purge.ts). 1–3650 (organizations_identity_retention_check).
  /// The default 365 is a PLACEHOLDER: the legal delay is to be confirmed by Sigma / its lawyer (loi 09-08, CNDP).
  identityRetentionDays Int      @default(365)
  createdAt             DateTime @default(now())

  users                User[]
  listings             Listing[]
  bookings             Booking[]
  reviews              Review[]
  wishlists            Wishlist[]
  wishlistItems        WishlistItem[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  priceRules           PriceRule[]
  tasks                Task[]
  checklistTemplates   ChecklistTemplate[]
  taskItems            TaskChecklistItem[]
  taskPhotos           TaskPhoto[]
  taskSyncOperations   TaskSyncOperation[]
  tickets              Ticket[]
  ticketEvents         TicketEvent[]
  ticketPhotos         TicketPhoto[]
  guides               ListingGuide[]
  guideAccessCodes     GuideAccessCode[]
  guidePhotos          GuidePhoto[]
  guideRecommendations GuideRecommendation[]
  guideLinks           GuideLink[]
  travelers            Traveler[]
  travelerDocuments    TravelerDocument[]
  identityPurges       IdentityPurge[]
  touristTaxRates      TouristTaxRate[]
  listingTaxRates      ListingTouristTaxRate[]
  bookingTaxes         BookingTouristTax[]
  channelFeeds         ChannelFeed[]
  channelSyncRuns      ChannelSyncRun[]
  channelConflicts     ChannelConflict[]

  @@map("organizations")
}

// ---------- Accounts (Better Auth) ----------

/// ADMIN = associé, AGENT = agent terrain, OWNER = propriétaire: members of one organization.
/// GUEST = voyageur, the only role a sign-up can get.
enum Role {
  ADMIN
  AGENT
  OWNER
  GUEST
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  image            String?
  /// Never set at sign-up (lib/server/auth.ts); changed by an ADMIN only.
  role             Role          @default(GUEST)
  phone            String?
  /// Null only for GUEST accounts; ADMIN, AGENT and OWNER need one (users_staff_organization_check).
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Double authentification (TOTP), Better Auth twoFactor plugin. Required for ADMIN and AGENT before /admin
  /// (lib/server/authz.ts); set by the plugin once the first code is verified, never by the client.
  twoFactorEnabled Boolean       @default(false)
  /// Soft deactivation by an ADMIN (Utilisateurs): no sign-in (lib/server/auth.ts), sessions revoked, every row kept.
  /// Null = active. Accounts are never deleted without the person's consent.
  deactivatedAt    DateTime?
  /// When the account last got a session (sign-in), set by lib/server/auth.ts. Null if it never signed in.
  lastSignInAt     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  /// Listings this user owns (role OWNER, same organization: see listings_owner_role_check).
  listings            Listing[]           @relation("OwnedListings")
  bookings            Booking[]
  reviews             Review[]
  wishlists           Wishlist[]
  invitationsSent     Invitation[]        @relation("InvitationsSent")
  invitationsAccepted Invitation[]        @relation("InvitationsAccepted")
  /// Field tasks assigned to this member (ADMIN or AGENT of the task's organization: tasks_assignee_check).
  tasksAssigned       Task[]              @relation("TaskAssignee")
  /// Offline « Ma journée » changes this member sent (idempotency records).
  taskSyncOperations  TaskSyncOperation[]
  /// Breakdown reports (Pannes) this member wrote, and those assigned to them (ADMIN or AGENT: tickets_assignee_check).
  ticketsReported     Ticket[]            @relation("TicketReporter")
  ticketsAssigned     Ticket[]            @relation("TicketAssignee")
  ticketEvents        TicketEvent[]

  /// Target of listings' (ownerId, organizationId) foreign key: an owner is always in the listing's organization.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// TOTP secret and backup codes of a user (Better Auth twoFactor plugin), both encrypted with BETTER_AUTH_SECRET.
/// `verified` stays false between enrollment and the first valid code.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  /// Consecutive failed codes at sign-in; the account is locked for 15 min after 10 (plugin default).
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@map("two_factors")
}

/// An ADMIN's invitation to join their organization as OWNER, AGENT or ADMIN (never GUEST: invitations_role_check).
/// The link holds a random token shown once to the admin; only its SHA-256 is stored (tokenHash). Single use:
/// accepting sets acceptedAt; revoking sets revokedAt; resending replaces tokenHash and expiresAt, so older links stop
/// working. At most one open invitation (not accepted, not revoked) per organization and e-mail
/// (invitations_open_email_key). See lib/server/invitations.ts.
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Lower case (invitations_email_lower_check).
  email          String
  role           Role
  /// Optional, for the WhatsApp share link; copied to the account at acceptance if it has none.
  phone          String?
  tokenHash      String       @unique
  expiresAt      DateTime
  invitedById    String?
  invitedBy      User?        @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedBy     User?        @relation("InvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@map("invitations")
}

/// Trail of security-sensitive actions (who, what, on what, when): invitations, role changes, 2FA resets,
/// deactivations, bookings typed, re-dated or cancelled by the team; finances will add theirs (Lot 6). actorId and
/// targetId are plain ids, not foreign keys, so an entry outlives the accounts it names. Written by lib/server/audit.ts in the same transaction as the change.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// The user who acted; null for the system.
  actorId        String?
  /// Dotted name, e.g. "user.role_changed" (lib/server/audit.ts: AuditAction).
  action         String
  /// "user", "invitation", "booking" (bookings and owner blocks typed in the back-office), "price_rule" (Prix) or
  /// "task" (Opérations: assignment, new time, status).
  targetType     String
  targetId       String
  /// What changed, e.g. { from: "AGENT", to: "OWNER" }. Never secrets (tokens, passwords, codes).
  details        Json         @default("{}")
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------- Catalogue ----------

model Place {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  /// slugify(name): accent/case-insensitive matching for autosuggest.
  searchName String
  country    String
  tagline    String
  imageUrl   String
  lat        Float
  lng        Float
  /// IANA zone; "today" for check-in and cancellation rules is the local date here.
  timezone   String    @default("Africa/Casablanca")
  listings   Listing[]

  @@index([searchName])
  @@map("places")
}

enum Category {
  HOME
  EXPERIENCE
}

enum PropertyType {
  APARTMENT
  HOUSE
  LOFT
  STUDIO
  VILLA
  CHALET
  ROOM
  HOTEL
  RIAD
}

/// MANAGED = mandat de gestion (Sigma earns commissionBps on revenue); SUBLEASE = sous-location (Sigma rents the
/// property from the owner and keeps the revenue; the rent is an expense).
enum ManagementType {
  MANAGED
  SUBLEASE
}

/// DRAFT = being prepared in the back-office, invisible to the public site (search, detail, booking, favourites);
/// PUBLISHED = in the catalogue. Publishing needs at least one photo (lib/server/admin/listings.ts).
enum ListingStatus {
  DRAFT
  PUBLISHED
}

model Listing {
  id               String         @id @default(cuid())
  category         Category       @default(HOME)
  /// Null for experiences.
  propertyType     PropertyType?
  title            String
  description      String
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  placeId          String
  place            Place          @relation(fields: [placeId], references: [id])
  /// The propriétaire. Never exposed by the public site or API (lib/server/catalog.ts).
  ownerId          String
  owner            User           @relation("OwnedListings", fields: [ownerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  /// Existing rows and direct inserts are PUBLISHED; the back-office creates listings as it is told (DRAFT by default).
  status           ListingStatus  @default(PUBLISHED)
  managementType   ManagementType @default(MANAGED)
  /// Sigma's commission in basis points (2000 = 20 %), 0–10000 (listings_commission_bps_check). New listings take
  /// their organization's defaultCommissionBps. Always 0 for SUBLEASE (listings_sublease_commission_check): Sigma
  /// keeps the revenue and pays the owner a rent, so there is no commission to take.
  commissionBps    Int            @default(2000)
  /// Street address, internal (team, guest guide); the public site shows only the neighbourhood.
  address          String
  city             String         @default("Marrakech")
  /// Règlement intérieur shown to guests (free text, one rule per line).
  houseRules       String         @default("")
  /// Loi 80-14 authorisation (number and expiry); null while the application is pending.
  licenseNumber    String?
  licenseExpiresAt DateTime?      @db.Date
  /// Shortest stay, in nights (listings_min_nights_check: at least 1). A price rule can raise it for the stays that
  /// have a night in its dates (effectiveMinNights, lib/pricing/engine.ts). Enforced by quoteStay and the search.
  minNights        Int            @default(1)
  /// Check-in / check-out time of this home in minutes after local midnight; null = the organization's.
  checkInMinutes   Int?
  checkOutMinutes  Int?
  /// Lot 7, protection against double bookings. preparationDays: nights kept free before each arrival and after each
  /// departure (0–7, listings_booking_rules_check), for the site's bookings and in every iCal export (lib/channels/busy.ts).
  /// minNoticeDays: the earliest arrival is today + this many days (0 = same day allowed, 1 = no same-day booking;
  /// 0–30). Both are to be set the same on each platform by hand (iCal carries no rule).
  preparationDays  Int            @default(0)
  minNoticeDays    Int            @default(0)
  lat              Float
  lng              Float
  maxGuests        Int
  bedrooms         Int            @default(0)
  beds             Int            @default(0)
  bathrooms        Float          @default(0)
  /// Centimes of dirham (MAD): per night for homes, per person for experiences. For homes this is the base price:
  /// price rules (PriceRule, lib/pricing/engine.ts) change it for some nights.
  priceCents       Int
  cleaningFeeCents Int            @default(0)
  isGuestFavorite  Boolean        @default(false)
  /// Denormalised from Review; kept in sync by lib/server/reviews.ts.
  ratingAvg        Float?
  reviewCount      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  photos               Photo[]
  amenities            ListingAmenity[]
  bookings             Booking[]
  reviews              Review[]
  wishlistItems        WishlistItem[]
  priceRules           PriceRuleListing[]
  tasks                Task[]
  tickets              Ticket[]
  /// Welcome guide (Lot 4): texts, Wi-Fi, access codes (encrypted), photos and recommendations of this home.
  guide                ListingGuide?
  guideAccessCodes     GuideAccessCode[]
  guidePhotos          GuidePhoto[]
  guideRecommendations GuideRecommendation[]
  /// Taxe de séjour rate of this home, overriding the organization's from a date (Lot 5).
  touristTaxRates      ListingTouristTaxRate[]
  /// Calendar synchronisation with the platforms by iCal (Lot 7): one feed per platform (export link, import URL).
  channelFeeds         ChannelFeed[]
  channelConflicts     ChannelConflict[]

  /// Target of bookings' (listingId, organizationId) foreign key: a booking is always in its listing's organization.
  @@unique([id, organizationId])
  @@index([organizationId, category])
  @@index([ownerId])
  @@index([placeId, category])
  @@index([lat, lng])
  @@map("listings")
}

/// position 0 is the cover. Uploaded photos have a storageKey (lib/storage); seeded ones are remote URLs without one.
model Photo {
  id         String  @id @default(cuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url        String
  alt        String  @default("")
  position   Int
  storageKey String? @unique

  @@index([listingId, position])
  @@map("photos")
}

model Amenity {
  id       String           @id
  label    String
  icon     String
  group    String
  listings ListingAmenity[]

  @@map("amenities")
}

model ListingAmenity {
  listingId String
  amenityId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([listingId, amenityId])
  @@map("listing_amenities")
}

// ---------- Activity ----------

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// Where a booking comes from. DIRECT = booked with Sigma (site, phone, WhatsApp); AIRBNB…EXPEDIA (Expedia and
/// Vrbo) and OTHER (any other platform giving an iCal link) = taken on a platform (imported by iCal or from its
/// confirmation e-mail, lot 7); OWNER = a propriétaire blocking their own dates (no guest, no amounts). Every source
/// blocks the dates (bookings_no_overlap).
enum BookingSource {
  DIRECT
  AIRBNB
  BOOKING
  AGODA
  TRIPCOM
  EXPEDIA
  OTHER
  OWNER
}

/// How the team received a DIRECT booking typed in the back-office (Réservations → Nouvelle saisie). NULL for
/// bookings made on the site and for every other source (bookings_channel_check).
enum BookingChannel {
  PHONE
  WHATSAPP
  EMAIL
  IN_PERSON
  OTHER
}

/// Integrity rules by source, in the database (migration 20261019090000_booking_sources):
/// - bookings_owner_block_check: an OWNER block has no guest (account or contact), no externalRef, no amounts
///   (all NULL) and no guest counts (all 0);
/// - bookings_external_ref_check: a platform booking always has a non-blank externalRef, and only platform
///   bookings have one;
/// - bookings_direct_guest_check: a DIRECT booking has a guest, an account (guestId) or at least a name;
/// - bookings_amounts_check: amounts are all set (total > 0) or, for a platform booking whose amount isn't known
///   yet (iCal carries none), all NULL; DIRECT always has them, OWNER never;
/// - bookings_no_overlap: no two CONFIRMED rows of a listing overlap, whatever their source;
/// - bookings_channel_check: only DIRECT bookings have a channel (migration 20261023090000_booking_entry).
/// externalRef is unique per (organizationId, source): see the migration for why not globally.
model Booking {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  listingId        String
  listing          Listing         @relation(fields: [listingId, organizationId], references: [id, organizationId])
  source           BookingSource   @default(DIRECT)
  /// The platform's code (Airbnb confirmation code, Booking.com number, iCal UID…). Platform bookings only.
  externalRef      String?
  /// The guest's account, when they have one (direct bookings from the site). Platform guests usually don't.
  guestId          String?
  guest            User?           @relation(fields: [guestId], references: [id], onDelete: Restrict)
  /// Guest contact for bookings without an account (platforms, phone). Internal: never shown by the public site.
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  checkIn          DateTime        @db.Date
  checkOut         DateTime        @db.Date
  /// At least 1 adult, except owner blocks (all counts 0).
  adults           Int
  children         Int             @default(0)
  infants          Int             @default(0)
  pets             Int             @default(0)
  /// Price snapshot at booking time, in centimes of dirham (MAD). NULL for owner blocks, and for platform bookings
  /// until their amount is known. Nights can have different prices (price rules): nightlyCents is then the average
  /// of the stay's nights, rounded to the centime, for information; totalCents is always the exact sum
  /// (Σ nights + cleaning + service fee) and is never recomputed from the average.
  nightlyCents     Int?
  cleaningFeeCents Int?
  serviceFeeCents  Int?
  totalCents       Int?
  status           BookingStatus   @default(CONFIRMED)
  /// DIRECT bookings typed by the team only: phone, WhatsApp… (migration 20261023090000_booking_entry).
  channel          BookingChannel?
  /// Internal note of the team (an owner block's reason, a guest's request). Never shown to guests or by the public
  /// site; 2 000 characters at most (bookings_note_length_check).
  note             String?
  /// The guest's language (guest locale code: fr, es, en…; lib/i18n/locales.ts) for the welcome guide and the
  /// messages; null = taken from the guest's browser (bookings_guest_locale_check).
  guestLocale      String?
  /// Lot 7: the iCal feed that created this booking (or adopted it: same platform code typed by hand). Only such
  /// bookings are re-dated or cancelled by that feed's imports; DIRECT and OWNER never have one
  /// (bookings_channel_check). Same listing and organization as the feed (composite foreign key).
  channelFeedId    String?
  channelFeed      ChannelFeed?    @relation(fields: [channelFeedId, listingId, organizationId], references: [id, listingId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  /// An imported unavailability without a guest (a platform's « Not available » block that isn't Sigma's own export
  /// echoed back): blocks the dates, gets no field task (lib/operations/sync.ts). Platform sources only.
  channelBlock     Boolean         @default(false)
  createdAt        DateTime        @default(now())
  cancelledAt      DateTime?

  /// Field tasks generated for this stay (lib/operations/sync.ts): linen and welcome on arrival, cleaning on departure.
  tasks      Task[]
  /// Breakdowns reported during this stay (Pannes).
  tickets    Ticket[]
  /// The secret link of this stay's welcome guide (/guide/<token>), if one was issued.
  guideLink  GuideLink?
  /// Travellers recorded for the police declaration (Lot 5), encrypted; deleted by the purge after the retention delay.
  travelers  Traveler[]
  /// Snapshot of the taxe de séjour of this stay (Lot 5).
  touristTax BookingTouristTax?
  /// Double-booking conflicts in which this booking holds the dates (Lot 7), or is the imported booking to re-date.
  conflictsBlocking ChannelConflict[] @relation("ConflictBlocking")
  conflictsOwn      ChannelConflict[] @relation("ConflictOwn")

  @@unique([organizationId, source, externalRef])
  /// Target of tasks' (bookingId, organizationId) foreign key.
  @@unique([id, organizationId])
  @@index([organizationId, checkIn])
  @@index([listingId, checkIn, checkOut])
  @@index([guestId, checkIn])
  @@index([channelFeedId])
  @@map("bookings")
}

/// organizationId is the listing's, through the (listingId, organizationId) foreign key.
model Review {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  listingId      String
  listing        Listing      @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  rating         Int
  body           String
  createdAt      DateTime     @default(now())

  @@index([organizationId, listingId])
  @@index([listingId, createdAt])
  @@map("reviews")
}

/// A guest's saved list in one organization (a guest of two organizations' sites has a "Favoris" in each).
model Wishlist {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime       @default(now())
  items          WishlistItem[]

  @@unique([organizationId, userId, name])
  /// Target of wishlist_items' (wishlistId, organizationId) foreign key.
  @@unique([id, organizationId])
  @@index([userId])
  @@map("wishlists")
}

/// organizationId is both the wishlist's and the listing's (two composite foreign keys): an item can't put another
/// organization's listing in a list.
model WishlistItem {
  wishlistId     String
  listingId      String
  organizationId String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  wishlist       Wishlist     @relation(fields: [wishlistId, organizationId], references: [id, organizationId], onDelete: Cascade)
  listing        Listing      @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([wishlistId, listingId])
  @@index([organizationId, listingId])
  @@map("wishlist_items")
}

// ---------- Prices (Lot 2e) ----------

/// SEASON = a period of the year (haute saison, basse saison); EVENT = a dated event (marathon, festival, fêtes).
/// An event beats a season of the same reach (lib/pricing/engine.ts: compareRules).
enum PriceRuleKind {
  SEASON
  EVENT
}

/// PERCENT = the listing's base price adjusted by percentBps (−90 % to +500 %), rounded to the dirham;
/// FIXED = fixedCents a night, for exactly one listing (checked by lib/server/admin/prices.ts).
enum PriceAdjustmentType {
  PERCENT
  FIXED
}

/// A season or an event of an organization that changes the nightly price and/or the minimum stay of its listings
/// for the nights from startDate to endDate, both included (nights are local dates, Africa/Casablanca). recurring =
/// the same day-month range every year (a range crossing 31/12 is allowed, e.g. 20/12 → 04/01). Applies to every
/// home of the organization (allListings) or to the listings of PriceRuleListing. Precedence, one rule a night:
/// one listing > a selection > all listings, then EVENT > SEASON, then priority, then the most recent
/// (lib/pricing/engine.ts). minNights raises the minimum stay of any stay with a night in the range.
/// Database checks (migration 20261024090000_price_rules): dates in order, a recurring range shorter than a year,
/// exactly one of percentBps/fixedCents matching adjustmentType and within bounds, a FIXED rule never for all
/// listings, minNights 1–365, priority 0–100, a name of 2–80 characters. Config, not personal data: an ADMIN can
/// delete a rule (audited).
model PriceRule {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           PriceRuleKind
  name           String
  /// First night covered.
  startDate      DateTime            @db.Date
  /// Last night covered (included).
  endDate        DateTime            @db.Date
  recurring      Boolean             @default(false)
  adjustmentType PriceAdjustmentType
  /// Basis points on the base price: 2000 = +20 %, -1000 = −10 %. PERCENT only.
  percentBps     Int?
  /// Centimes of dirham a night. FIXED only.
  fixedCents     Int?
  /// Minimum stay for stays with a night in the range; null = the listing's own.
  minNights      Int?
  /// 0–100, higher wins between rules of the same reach and kind.
  priority       Int                 @default(0)
  /// Every home of the organization, present and future. Otherwise the listings of PriceRuleListing.
  allListings    Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  listings PriceRuleListing[]

  /// Target of price_rule_listings' (ruleId, organizationId) foreign key.
  @@unique([id, organizationId])
  @@index([organizationId, endDate])
  @@map("price_rules")
}

/// The listings a rule applies to (when not allListings). organizationId is both the rule's and the listing's (two
/// composite foreign keys): a rule can't reach another organization's listing.
model PriceRuleListing {
  ruleId         String
  listingId      String
  organizationId String
  rule           PriceRule @relation(fields: [ruleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  listing        Listing   @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([ruleId, listingId])
  @@index([organizationId, listingId])
  @@map("price_rule_listings")
}

// ---------- Field operations (Lot 3) ----------

/// CLEANING = ménage après départ; LINEN = préparation du linge (before the arrival); CHECKIN = accueil à l'arrivée;
/// OTHER = anything typed by hand (courses, réparation simple…).
enum TaskType {
  CLEANING
  LINEN
  CHECKIN
  OTHER
}

/// TODO = à faire, IN_PROGRESS = en cours, DONE = fait (only with every item ticked and every required photo:
/// lib/operations/checklist.ts, enforced by lib/server/operations/tasks.ts), CANCELLED = the stay was cancelled or
/// an associé cancelled the task.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

/// A field task on a home. Generated ones have a bookingId and are kept in sync with their stay
/// (lib/operations/sync.ts: one per booking and type, tasks_booking_type_key); manual ones have none. scheduledDate is
/// the local day (Africa/Casablanca, the listing's place) and startsAt/endsAt the window as instants. anchorDate is
/// the stay's day the task was placed from (arrival for LINEN/CHECKIN, departure for CLEANING): a re-sync moves the
/// task only when that day changed, so an associé's new time survives. Database checks (migration
/// 20261025090000_field_tasks): a window that ends after it starts, status timestamps that match the status, notes
/// and titles of bounded length, an assignee who is ADMIN or AGENT of the organization (tasks_assignee_check trigger).
model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  listingId      String
  listing        Listing      @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  type           TaskType
  status         TaskStatus   @default(TODO)
  /// Manual tasks only (OTHER, or a one-off cleaning); generated tasks are named by their type.
  title          String?
  scheduledDate  DateTime     @db.Date
  startsAt       DateTime
  endsAt         DateTime
  anchorDate     DateTime?    @db.Date
  /// CLEANING only: another stay (or an owner block) arrives the same day, so the home must be ready by check-in.
  turnover       Boolean      @default(false)
  notes          String?
  /// What the agent wrote while doing the task (Ma journée), as opposed to the associé's instructions (notes).
  fieldNotes     String?
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Plain id (not a foreign key): null for generated tasks.
  createdById    String?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items   TaskChecklistItem[]
  photos  TaskPhoto[]
  tickets Ticket[]

  @@unique([bookingId, type])
  /// Target of the items' and photos' (taskId, organizationId) foreign keys.
  @@unique([id, organizationId])
  @@index([organizationId, scheduledDate])
  @@index([assigneeId, scheduledDate])
  @@index([listingId, scheduledDate])
  @@map("tasks")
}

/// The organization's default check-list of a task type, copied onto each new task (items: [{ label, requiresPhoto }]).
/// Seeded in French for every organization (migration 20261025090000_field_tasks, prisma/seed.ts) and created from
/// lib/operations/checklist.ts DEFAULT_CHECKLISTS when missing. Changing a template doesn't change existing tasks.
model ChecklistTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           TaskType
  items          Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, type])
  @@map("checklist_templates")
}

/// One line of a task's check-list. requiresPhoto: the task can't be DONE before a photo of this item is uploaded.
model TaskChecklistItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taskId         String
  task           Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  position       Int
  label          String
  requiresPhoto  Boolean      @default(false)
  checkedAt      DateTime?
  /// Plain id of who ticked it.
  checkedById    String?

  photos TaskPhoto[]

  @@unique([taskId, position])
  @@map("task_checklist_items")
}

/// A photo taken during a task, for one check-list item (or the task as a whole when itemId is null). Stored by
/// lib/storage under tasks/<organizationId>/<taskId>/…, served by /media only to the organization's staff.
model TaskPhoto {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taskId         String
  task           Task               @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  itemId         String?
  item           TaskChecklistItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storageKey     String             @unique
  url            String
  /// Plain id of who took it.
  uploadedById   String?
  createdAt      DateTime           @default(now())

  @@index([taskId])
  @@index([itemId])
  @@map("task_photos")
}

/// One change made in « Ma journée » (start, tick, note, photo, finish), possibly while offline, identified by the id
/// the phone gave it (opId, random): sending it again (a retry after a lost answer) returns the recorded outcome
/// instead of applying it twice (lib/server/operations/field-sync.ts). REJECTED = the server refused it (task
/// reassigned or cancelled meanwhile, already done…): the server wins and the agent is told why. taskId is a plain
/// id (no foreign key): a refused operation may name a task the agent can't see. Kept 30 days (to be purged by the
/// background jobs of lot 7).
model TaskSyncOperation {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  opId           String
  taskId         String
  kind           String
  outcome        TaskSyncOutcome
  code           String?
  message        String?
  /// When the agent made the change on the phone (as the phone told it).
  clientAt       DateTime?
  createdAt      DateTime        @default(now())

  @@unique([userId, opId])
  @@index([organizationId, createdAt])
  @@map("task_sync_operations")
}

enum TaskSyncOutcome {
  APPLIED
  REJECTED
}

// ---------- Breakdowns (Pannes) ----------

enum TicketCategory {
  PLUMBING
  ELECTRICITY
  AIR_CONDITIONING
  APPLIANCE
  LOCK
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// OPEN = signalée, IN_PROGRESS = en cours de réparation, WAITING = en attente (d'une pièce ou d'un prestataire:
/// waitingFor), RESOLVED = réparée (resolvedAt), CANCELLED = annulée (doublon, fausse alerte).
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CANCELLED
}

enum TicketWaitingFor {
  PART
  CONTRACTOR
}

enum TicketEventKind {
  CREATED
  COMMENT
  STATUS
  ASSIGNED
  PRIORITY
  COST
  PHOTO
}

/// A breakdown reported on a home, followed until it is fixed (lib/server/operations/tickets.ts). Optionally linked to
/// the stay (bookingId) or the field task (taskId) it was found during; both are of the same home and organization
/// (tickets_links_check trigger) and are set to null if that row ever goes. costCents: what the repair cost, in
/// centimes of dirham; rechargeOwner: to be re-invoiced to the owner (the owner statements of lot 6 will read it).
/// Associés see and manage every ticket; an agent sees the tickets they reported or are assigned.
model Ticket {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  listingId      String
  listing        Listing           @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  bookingId      String?
  booking        Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title          String
  description    String            @default("")
  category       TicketCategory
  priority       TicketPriority    @default(NORMAL)
  status         TicketStatus      @default(OPEN)
  waitingFor     TicketWaitingFor?
  reporterId     String?
  reporter       User?             @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?             @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  costCents      Int?
  rechargeOwner  Boolean           @default(false)
  resolvedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  events TicketEvent[]
  photos TicketPhoto[]

  /// Target of the events' and photos' (ticketId, organizationId) foreign keys.
  @@unique([id, organizationId])
  @@index([organizationId, status, priority])
  @@index([listingId])
  @@index([reporterId])
  @@index([assigneeId])
  @@map("tickets")
}

/// The thread of a ticket: its creation, comments, and every change (status, assignment, priority, cost, photo).
model TicketEvent {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticketId       String
  ticket         Ticket          @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId       String?
  author         User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind           TicketEventKind
  /// The comment (COMMENT), or the note given with a change of status.
  body           String?
  /// What changed: { from, to } and the like. Never a secret.
  details        Json            @default("{}")
  createdAt      DateTime        @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

/// A photo of a breakdown, stored by lib/storage under tickets/<organizationId>/<ticketId>/…, served by /media only to
/// the staff who can see the ticket.
model TicketPhoto {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticketId       String
  ticket         Ticket       @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade)
  storageKey     String       @unique
  url            String
  uploadedById   String?
  createdAt      DateTime     @default(now())

  @@index([ticketId])
  @@map("ticket_photos")
}

// ---------- Welcome guide (Lot 4) ----------

/// What a code opens, for its label in the guide (lib/guide/labels.ts and the guest messages).
enum GuideAccessCodeKind {
  DOOR
  KEYBOX
  ALARM
  GATE
  PARKING
  OTHER
}

enum GuideRecommendationCategory {
  RESTAURANT
  CAFE
  HAMMAM
  SOUK
  CULTURE
  NATURE
  SHOPPING
  OTHER
}

/// The welcome guide of a home, shown to its guests at /guide/<token> (lib/server/guide/guest.ts). Texts are
/// localized: a JSON object { fr, es?, en? } (lib/i18n/localized.ts), French required to be shown, the others falling
/// back to French. The French house rules are the listing's houseRules; houseRulesTranslations holds the others.
/// wifiPasswordEnc is an AES-256-GCM envelope (lib/secrets/access-codes.ts), never the password itself
/// (listing_guides_secret_check); like the codes, it is shown to guests only during their stay.
model ListingGuide {
  listingId              String       @id
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  listing                Listing      @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// A maps link (https) to the door; null = built from the listing's coordinates.
  mapsUrl                String?
  directions             Json         @default("{}")
  accessInstructions     Json         @default("{}")
  houseRulesTranslations Json         @default("{}")
  wifiName               String?
  wifiPasswordEnc        String?
  /// Show the organization's default recommendations after the home's own.
  useOrgRecommendations  Boolean      @default(true)
  /// Plain id of who last changed it.
  updatedById            String?
  updatedAt              DateTime     @updatedAt

  @@unique([listingId, organizationId])
  @@index([organizationId])
  @@map("listing_guides")
}

/// An access code of a home (door, key box, alarm…), encrypted at rest (valueEnc: AES-256-GCM envelope bound to the
/// organization and the listing; guide_access_codes_value_check). Shown to the associés on request (audited), to an
/// agent only for a home where they have a task today or tomorrow (audited), and to guests only between check-in and
/// check-out (lib/guide/window.ts).
model GuideAccessCode {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  listingId      String
  listing        Listing             @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  kind           GuideAccessCodeKind
  /// Optional precision ("Porte de la terrasse"), French, shown under the kind's label.
  label          String              @default("")
  valueEnc       String
  position       Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([listingId, position])
  @@map("guide_access_codes")
}

/// A photo of the access instructions (the door, the key box…), stored by lib/storage under
/// guides/<organizationId>/<listingId>/…, served to guests only through their guide link and to the associés.
model GuidePhoto {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  listingId      String
  listing        Listing      @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  storageKey     String       @unique
  caption        String       @default("")
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([listingId, position])
  @@map("guide_photos")
}

/// A recommendation (restaurant, hammam, souk…): of one home (listingId), or of the organization, offered in every
/// guide whose home keeps useOrgRecommendations (listingId null). description is localized like the guide's texts.
/// A home's recommendation is of the home's organization (guide_recommendations_listing_check trigger).
model GuideRecommendation {
  id             String                      @id @default(cuid())
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing?                    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category       GuideRecommendationCategory
  name           String
  description    Json                        @default("{}")
  /// https link (website, maps), optional.
  url            String?
  position       Int                         @default(0)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([organizationId, listingId, position])
  @@map("guide_recommendations")
}

/// The secret link of a stay's welcome guide, /guide/<token>: 32 random bytes, looked up by their SHA-256
/// (tokenHash); tokenEnc keeps the token encrypted (AES-256-GCM, bound to the booking) so that the associés can copy
/// the link again. One per booking: regenerating replaces both (the old link stops working), revoking sets
/// revokedAt. Never for an owner block (guide_links_booking_check trigger); a cancelled stay's link answers 404.
model GuideLink {
  bookingId      String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking        Booking      @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tokenHash      String       @unique
  tokenEnc       String
  /// Plain id of the associé who issued it.
  createdById    String?
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@unique([bookingId, organizationId])
  @@index([organizationId])
  @@map("guide_links")
}

// ---------- Travellers' declaration and taxe de séjour (Lot 5) ----------

/// A traveller of a stay, for the police declaration (fiche de police, télé-déclaration DGSN). Every personal field
/// (names, sex, birth, nationality, document, address, residence, profession, arrival/departure, provenance,
/// destination) is in identityEnc, one AES-256-GCM envelope (lib/secrets/identity.ts, IDENTITY_DOCS_KEY) bound to
/// the organization, the booking and the traveller: the database never holds them in clear
/// (travelers_identity_check). In clear only what is not personal: whether the traveller is a minor (under 18 on
/// arrival), the accompanying adult (guardianId, same stay: travelers_guardian_check trigger) and whether and when
/// they were declared. Deleted, with their document scans, by the purge after the organization's retention delay
/// (lib/server/declarations/purge.ts), leaving an IdentityPurge trace. Never for an owner block
/// (travelers_booking_check trigger).
model Traveler {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  identityEnc    String
  isMinor        Boolean      @default(false)
  guardianId     String?
  guardian       Traveler?    @relation("TravelerGuardian", fields: [guardianId], references: [id], onDelete: SetNull)
  minors         Traveler[]   @relation("TravelerGuardian")
  /// Declared to the authorities (télé-déclaration done) and by whom (plain id).
  declaredAt     DateTime?
  declaredById   String?
  /// Plain ids of who typed and last changed the fiche.
  createdById    String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  documents TravelerDocument[]

  /// Target of the documents' (travelerId, organizationId) foreign key.
  @@unique([id, organizationId])
  @@index([bookingId])
  @@index([organizationId, declaredAt])
  @@map("travelers")
}

/// A scan or photo of a traveller's identity document, encrypted (lib/secrets/identity.ts) before it is handed to
/// lib/storage (key identity/<organizationId>/<bookingId>/<random>.enc): the stored file is never readable as such.
/// Served decrypted only to the associés, by GET /api/admin/declarations/documents/<id> (audited, never cached).
model TravelerDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  travelerId     String
  traveler       Traveler     @relation(fields: [travelerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  storageKey     String       @unique
  /// The type of the clear file (sniffed from its bytes): image/jpeg, image/png, image/webp or application/pdf.
  contentType    String
  byteSize       Int
  uploadedById   String?
  createdAt      DateTime     @default(now())

  @@index([travelerId])
  @@map("traveler_documents")
}

/// What is left of a stay's identity data after the automatic purge: no personal data, only counts. bookingId is a
/// plain id (the trace outlives the booking).
model IdentityPurge {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookingId      String
  checkOut       DateTime     @db.Date
  travelerCount  Int
  minorCount     Int
  declaredCount  Int
  documentCount  Int
  retentionDays  Int
  purgedAt       DateTime     @default(now())

  @@index([organizationId, purgedAt])
  @@index([bookingId])
  @@map("identity_purges")
}

/// A version of the organization's taxe de séjour, in force from effectiveFrom (a local date) until the next version:
/// the rate per taxable guest per night (centimes of dirham) and the exemptions (lib/tax/engine.ts). Versions are
/// never edited: a change of rate is a new version, so the nights before it keep their rate. The real rates and
/// exemptions are to be confirmed by Sigma with the commune / the accountant. Checks: tourist_tax_rates_check.
model TouristTaxRate {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  effectiveFrom     DateTime     @db.Date
  rateCents         Int
  /// Guests under this age on arrival are exempt; null = no exemption for minors.
  minorsExemptUnder Int?         @default(18)
  /// Guests residing in Morocco are exempt.
  residentsExempt   Boolean      @default(false)
  /// Where the rate comes from (« délibération communale n° … », « taux de démonstration »…).
  note              String       @default("")
  createdById       String?
  createdAt         DateTime     @default(now())

  @@unique([organizationId, effectiveFrom])
  @@map("tourist_tax_rates")
}

/// A home's own taxe de séjour rate from effectiveFrom (rateCents null = back to the organization's rate). The
/// exemptions are always the organization's. Same organization as the home (composite foreign key).
model ListingTouristTaxRate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing      @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  effectiveFrom  DateTime     @db.Date
  rateCents      Int?
  note           String       @default("")
  createdById    String?
  createdAt      DateTime     @default(now())

  @@unique([listingId, effectiveFrom])
  @@index([organizationId])
  @@map("listing_tourist_tax_rates")
}

/// TRAVELERS = computed from the recorded travellers (completed from the booking's counts); BOOKING = from the
/// booking's counts only (no traveller recorded yet).
enum TouristTaxBasis {
  TRAVELERS
  BOOKING
}

/// The taxe de séjour of a stay as last computed (lib/tax/engine.ts): total in centimes and the night-by-night lines
/// ({ night, rateCents, taxable, exempt, amountCents, … }). Recomputed when travellers are recorded or changed and
/// when the dates change, until an associé closes it (closedAt: « clôturé », e.g. once paid to the commune); a
/// closed snapshot never changes. Checks: booking_tourist_taxes_check.
model BookingTouristTax {
  bookingId          String          @id
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking            Booking         @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  totalCents         Int
  nights             Int
  taxableGuestNights Int
  exemptGuestNights  Int
  missingRateNights  Int
  basis              TouristTaxBasis
  lines              Json
  computedAt         DateTime
  computedById       String?
  closedAt           DateTime?
  closedById         String?

  @@unique([bookingId, organizationId])
  @@index([organizationId])
  @@map("booking_tourist_taxes")
}

// ---------- Calendar synchronisation with the platforms (Lot 7) ----------

/// SUCCESS = the feed was read and applied; NOT_MODIFIED = the platform answered 304 (nothing changed since the last
/// read, ETag / Last-Modified); ERROR = unreachable, refused, too large, invalid file… (errorCode, errorMessage).
enum ChannelSyncOutcome {
  SUCCESS
  NOT_MODIFIED
  ERROR
}

/// SCHEDULED = the background worker (every 10 minutes per feed); MANUAL = « Synchroniser maintenant ».
enum ChannelSyncTrigger {
  SCHEDULED
  MANUAL
}

enum ChannelConflictStatus {
  OPEN
  RESOLVED
}

/// How a conflict ended: REPLACED = an associé cancelled the booking holding the dates and the imported one took them;
/// DISMISSED = marked as handled by an associé (e.g. the platform booking was cancelled on the platform); EVENT_GONE =
/// the event left the platform's feed; FREED = the dates became free and the import went through on its own.
enum ChannelConflictResolution {
  REPLACED
  DISMISSED
  EVENT_GONE
  FREED
}

/// A listing's link with one platform (lib/channels/): the secret export link the platform imports
/// (/ical/<token>.ics: 256 random bits, looked up by SHA-256 exportTokenHash, kept encrypted in exportTokenEnc so the
/// associés can copy it again; revocable and regenerable) and, optionally, the platform's own iCal link that Sigma
/// reads every 10 minutes (importUrlEnc: an AES-256-GCM envelope, the URL is a secret; importHost is only its host
/// name, for display). Health of the import: lastSuccessAt, lastStatus, lastError, consecutiveFailures, staleAlertedAt
/// (the team was told it hasn't been read for more than an hour). nextSyncAt: when the worker reads it next
/// (scripts/worker.ts). One per listing and platform; never deleted (removing the import URL keeps the export link
/// and the bookings already imported).
model ChannelFeed {
  id                  String              @id @default(cuid())
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  listingId           String
  listing             Listing             @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The platform (a platform source: never DIRECT or OWNER, channel_feeds_check).
  source              BookingSource
  exportTokenHash     String              @unique
  exportTokenEnc      String
  exportRevokedAt     DateTime?
  exportIssuedAt      DateTime            @default(now())
  importUrlEnc        String?
  importHost          String?
  importUrlSetAt      DateTime?
  importEnabled       Boolean             @default(true)
  /// Conditional request validators of the last successful read.
  etag                String?
  lastModified        String?
  nextSyncAt          DateTime            @default(now())
  lastSyncAt          DateTime?
  lastSuccessAt       DateTime?
  lastStatus          ChannelSyncOutcome?
  lastError           String?
  consecutiveFailures Int                 @default(0)
  staleAlertedAt      DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  bookings  Booking[]
  runs      ChannelSyncRun[]
  conflicts ChannelConflict[]

  @@unique([listingId, source])
  /// Targets of the bookings', runs' and conflicts' composite foreign keys.
  @@unique([id, listingId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([nextSyncAt])
  @@map("channel_feeds")
}

/// The journal of every read of a feed: when, how (scheduled or by hand), the platform's HTTP status, how many events
/// the file had and what they changed (created, updated, cancelled bookings, conflicts, ignored events — past,
/// Sigma's own export echoed back, already handled), or the error. Never the URL or a guest's data. Kept 90 days.
model ChannelSyncRun {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  feedId         String
  feed           ChannelFeed        @relation(fields: [feedId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// Plain copies, for the journal's filters.
  listingId      String
  source         BookingSource
  trigger        ChannelSyncTrigger
  /// Plain id of who asked (MANUAL).
  requestedById  String?
  startedAt      DateTime           @default(now())
  finishedAt     DateTime?
  outcome        ChannelSyncOutcome?
  httpStatus     Int?
  eventsSeen     Int                @default(0)
  created        Int                @default(0)
  updated        Int                @default(0)
  cancelled      Int                @default(0)
  conflicts      Int                @default(0)
  ignored        Int                @default(0)
  errorCode      String?
  errorMessage   String?

  @@index([organizationId, startedAt])
  @@index([feedId, startedAt])
  @@index([listingId, startedAt])
  @@map("channel_sync_runs")
}

/// A double booking found by an import (Lot 7): the platform's event (source, externalRef = the event's reference,
/// nights checkIn → checkOut) overlaps a confirmed booking or block of the listing (blockingBookingId; its source and
/// reference copied, in case it goes). The imported reservation is kept HERE, not in bookings, so that the exclusion
/// constraint bookings_no_overlap still holds for every CONFIRMED row; ownBookingId is set when the event is an
/// already-imported booking that the platform moved onto taken dates (it keeps its old dates meanwhile). Open
/// conflicts show as a red banner in the back-office and their nights are exported as busy to the other platforms.
/// At most one open conflict per feed and event (channel_conflicts_open_key).
model ChannelConflict {
  id                String                     @id @default(cuid())
  organizationId    String
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  listingId         String
  listing           Listing                    @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  feedId            String
  feed              ChannelFeed                @relation(fields: [feedId, listingId, organizationId], references: [id, listingId, organizationId], onDelete: Cascade)
  source            BookingSource
  externalRef       String
  checkIn           DateTime                   @db.Date
  checkOut          DateTime                   @db.Date
  /// The event is a platform « Not available » block rather than a reservation.
  block             Boolean                    @default(false)
  blockingBookingId String?
  blockingBooking   Booking?                   @relation("ConflictBlocking", fields: [blockingBookingId], references: [id], onDelete: SetNull)
  blockingSource    BookingSource
  blockingRef       String?
  blockingCheckIn   DateTime                   @db.Date
  blockingCheckOut  DateTime                   @db.Date
  ownBookingId      String?
  ownBooking        Booking?                   @relation("ConflictOwn", fields: [ownBookingId], references: [id], onDelete: SetNull)
  status            ChannelConflictStatus      @default(OPEN)
  resolution        ChannelConflictResolution?
  detectedAt        DateTime                   @default(now())
  lastSeenAt        DateTime                   @default(now())
  resolvedAt        DateTime?
  /// Plain id of the associé who resolved it (null: resolved by an import).
  resolvedById      String?

  @@index([organizationId, status])
  @@index([listingId, status])
  @@index([feedId])
  @@map("channel_conflicts")
}

/// The background worker's recurring jobs (scripts/worker.ts, lib/server/jobs/): one row per job, when it runs next
/// and how its last run went. Two workers never run the same job (Postgres advisory locks). System-wide, not an
/// organization's data.
model ScheduledJob {
  name           String    @id
  nextRunAt      DateTime
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastOk         Boolean?
  lastError      String?
  lastDetails    Json      @default("{}")
  runCount       Int       @default(0)

  @@map("scheduled_jobs")
}
