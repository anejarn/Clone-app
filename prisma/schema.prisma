// Data model: docs/architecture.md §5. The first four models are the tables Better Auth expects.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Organizations ----------

/// A property manager using the app. Sigma is the first; every business row belongs to exactly one (V3 prepares
/// other concierges). What is specific to one manager (commission, partners, catalogue, brand) lives here.
model Organization {
  id                   String   @id @default(cuid())
  name                 String
  /// The public site shows the catalogue of the organization named by SIGMA_ORG_SLUG (default "sigma").
  slug                 String   @unique
  /// Default owner commission, in basis points (2000 = 20 %).
  defaultCommissionBps Int      @default(2000)
  createdAt            DateTime @default(now())

  users         User[]
  listings      Listing[]
  bookings      Booking[]
  reviews       Review[]
  wishlists     Wishlist[]
  wishlistItems WishlistItem[]

  @@map("organizations")
}

// ---------- Accounts (Better Auth) ----------

/// ADMIN = associé, AGENT = agent terrain, OWNER = propriétaire: members of one organization.
/// GUEST = voyageur, the only role a sign-up can get.
enum Role {
  ADMIN
  AGENT
  OWNER
  GUEST
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  emailVerified  Boolean       @default(false)
  image          String?
  /// Never set at sign-up (lib/server/auth.ts); changed by an ADMIN only.
  role           Role          @default(GUEST)
  phone          String?
  /// Null only for GUEST accounts; ADMIN, AGENT and OWNER need one (users_staff_organization_check).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sessions  Session[]
  accounts  Account[]
  /// Listings this user owns (role OWNER, same organization: see listings_owner_role_check).
  listings  Listing[]  @relation("OwnedListings")
  bookings  Booking[]
  reviews   Review[]
  wishlists Wishlist[]

  /// Target of listings' (ownerId, organizationId) foreign key: an owner is always in the listing's organization.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------- Catalogue ----------

model Place {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  /// slugify(name): accent/case-insensitive matching for autosuggest.
  searchName String
  country    String
  tagline    String
  imageUrl   String
  lat        Float
  lng        Float
  /// IANA zone; "today" for check-in and cancellation rules is the local date here.
  timezone   String    @default("Africa/Casablanca")
  listings   Listing[]

  @@index([searchName])
  @@map("places")
}

enum Category {
  HOME
  EXPERIENCE
}

enum PropertyType {
  APARTMENT
  HOUSE
  LOFT
  STUDIO
  VILLA
  CHALET
  ROOM
  HOTEL
  RIAD
}

/// MANAGED = mandat de gestion (Sigma earns commissionBps on revenue); SUBLEASE = sous-location (Sigma rents the
/// property from the owner and keeps the revenue; the rent is an expense).
enum ManagementType {
  MANAGED
  SUBLEASE
}

model Listing {
  id               String         @id @default(cuid())
  category         Category       @default(HOME)
  /// Null for experiences.
  propertyType     PropertyType?
  title            String
  description      String
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  placeId          String
  place            Place          @relation(fields: [placeId], references: [id])
  /// The propriétaire. Never exposed by the public site or API (lib/server/catalog.ts).
  ownerId          String
  owner            User           @relation("OwnedListings", fields: [ownerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  managementType   ManagementType @default(MANAGED)
  /// Sigma's commission in basis points (2000 = 20 %), 0–10000 (listings_commission_bps_check). New listings take
  /// their organization's defaultCommissionBps.
  commissionBps    Int            @default(2000)
  /// Street address, internal (team, guest guide); the public site shows only the neighbourhood.
  address          String
  /// Loi 80-14 authorisation (number and expiry); null while the application is pending.
  licenseNumber    String?
  licenseExpiresAt DateTime?      @db.Date
  /// Shortest stay, in nights (listings_min_nights_check: at least 1). Enforced by quoteStay.
  minNights        Int            @default(1)
  lat              Float
  lng              Float
  maxGuests        Int
  bedrooms         Int            @default(0)
  beds             Int            @default(0)
  bathrooms        Float          @default(0)
  /// Centimes of dirham (MAD): per night for homes, per person for experiences.
  priceCents       Int
  cleaningFeeCents Int            @default(0)
  isGuestFavorite  Boolean        @default(false)
  /// Denormalised from Review; kept in sync by lib/server/reviews.ts.
  ratingAvg        Float?
  reviewCount      Int            @default(0)
  createdAt        DateTime       @default(now())

  photos        Photo[]
  amenities     ListingAmenity[]
  bookings      Booking[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  /// Target of bookings' (listingId, organizationId) foreign key: a booking is always in its listing's organization.
  @@unique([id, organizationId])
  @@index([organizationId, category])
  @@index([ownerId])
  @@index([placeId, category])
  @@index([lat, lng])
  @@map("listings")
}

model Photo {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int

  @@index([listingId, position])
  @@map("photos")
}

model Amenity {
  id       String           @id
  label    String
  icon     String
  group    String
  listings ListingAmenity[]

  @@map("amenities")
}

model ListingAmenity {
  listingId String
  amenityId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([listingId, amenityId])
  @@map("listing_amenities")
}

// ---------- Activity ----------

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// Where a booking comes from. DIRECT = booked with Sigma (site, phone, WhatsApp); AIRBNB…EXPEDIA = taken on a
/// platform (imported by iCal or from its confirmation e-mail, lot 7); OWNER = a propriétaire blocking their own
/// dates (no guest, no amounts). Every source blocks the dates (bookings_no_overlap).
enum BookingSource {
  DIRECT
  AIRBNB
  BOOKING
  AGODA
  TRIPCOM
  EXPEDIA
  OWNER
}

/// Integrity rules by source, in the database (migration 20261019090000_booking_sources):
/// - bookings_owner_block_check: an OWNER block has no guest (account or contact), no externalRef, no amounts
///   (all NULL) and no guest counts (all 0);
/// - bookings_external_ref_check: a platform booking always has a non-blank externalRef, and only platform
///   bookings have one;
/// - bookings_direct_guest_check: a DIRECT booking has a guest, an account (guestId) or at least a name;
/// - bookings_amounts_check: amounts are all set (total > 0) or, for a platform booking whose amount isn't known
///   yet (iCal carries none), all NULL; DIRECT always has them, OWNER never;
/// - bookings_no_overlap: no two CONFIRMED rows of a listing overlap, whatever their source.
/// externalRef is unique per (organizationId, source): see the migration for why not globally.
model Booking {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id])
  listingId        String
  listing          Listing       @relation(fields: [listingId, organizationId], references: [id, organizationId])
  source           BookingSource @default(DIRECT)
  /// The platform's code (Airbnb confirmation code, Booking.com number, iCal UID…). Platform bookings only.
  externalRef      String?
  /// The guest's account, when they have one (direct bookings from the site). Platform guests usually don't.
  guestId          String?
  guest            User?         @relation(fields: [guestId], references: [id], onDelete: Restrict)
  /// Guest contact for bookings without an account (platforms, phone). Internal: never shown by the public site.
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  checkIn          DateTime      @db.Date
  checkOut         DateTime      @db.Date
  /// At least 1 adult, except owner blocks (all counts 0).
  adults           Int
  children         Int           @default(0)
  infants          Int           @default(0)
  pets             Int           @default(0)
  /// Price snapshot at booking time, in centimes of dirham (MAD). NULL for owner blocks, and for platform bookings
  /// until their amount is known.
  nightlyCents     Int?
  cleaningFeeCents Int?
  serviceFeeCents  Int?
  totalCents       Int?
  status           BookingStatus @default(CONFIRMED)
  createdAt        DateTime      @default(now())
  cancelledAt      DateTime?

  @@unique([organizationId, source, externalRef])
  @@index([organizationId, checkIn])
  @@index([listingId, checkIn, checkOut])
  @@index([guestId, checkIn])
  @@map("bookings")
}

/// organizationId is the listing's, through the (listingId, organizationId) foreign key.
model Review {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  listingId      String
  listing        Listing      @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  rating         Int
  body           String
  createdAt      DateTime     @default(now())

  @@index([organizationId, listingId])
  @@index([listingId, createdAt])
  @@map("reviews")
}

/// A guest's saved list in one organization (a guest of two organizations' sites has a "Favoris" in each).
model Wishlist {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime       @default(now())
  items          WishlistItem[]

  @@unique([organizationId, userId, name])
  /// Target of wishlist_items' (wishlistId, organizationId) foreign key.
  @@unique([id, organizationId])
  @@index([userId])
  @@map("wishlists")
}

/// organizationId is both the wishlist's and the listing's (two composite foreign keys): an item can't put another
/// organization's listing in a list.
model WishlistItem {
  wishlistId     String
  listingId      String
  organizationId String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  wishlist       Wishlist     @relation(fields: [wishlistId, organizationId], references: [id, organizationId], onDelete: Cascade)
  listing        Listing      @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([wishlistId, listingId])
  @@index([organizationId, listingId])
  @@map("wishlist_items")
}
