{
  "permissions": {
    "deny": [
      "Bash(pnpm db:reset*)",
      "Bash(*prisma migrate reset*)",
      "Bash(dropdb*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(pkill -f*)",
      "Bash(*playwright install*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf .git*)",
      "Edit(.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 600,
            "statusMessage": "Garde-fou Sigma…"
          }
        ]
      }
    ]
  }
}
