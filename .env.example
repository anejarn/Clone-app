# Postgres connection (docker compose up -d starts one matching this URL)
DATABASE_URL="postgresql://sigma:sigma@localhost:5432/sigma?schema=public"
# Session signing secret: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public origin of the app
BETTER_AUTH_URL="http://localhost:3000"
# Organization whose catalogue the public site shows (lib/server/org.ts); "sigma" when unset
SIGMA_ORG_SLUG="sigma"
# Where uploaded listing photos are stored (lib/storage/local.ts); ./uploads when unset
# UPLOAD_DIR="/var/lib/sigma/uploads"
# Outgoing e-mail/WhatsApp (lib/notifications): no provider yet. "console" prints messages in development only.
# NOTIFICATIONS_DRIVER="console"
# Encryption key of the welcome guide's secrets (access codes, Wi-Fi passwords, guide links), AES-256-GCM
# (lib/secrets/access-codes.ts): 32 random bytes in base64, `openssl rand -base64 32`. Required in production (nothing
# is encrypted or shown without it); development and tests fall back to a public development key. Keep it apart from
# the database backups. Rotation: new key here, the old one in ACCESS_CODES_PREVIOUS_KEYS, restart, `pnpm secrets:rotate`.
ACCESS_CODES_KEY=""
# ACCESS_CODES_PREVIOUS_KEYS="<old key in base64>,<older key>"
# Encryption key of the travellers' identity data (fiches de police and document scans, Lot 5), AES-256-GCM
# (lib/secrets/identity.ts): 32 random bytes in base64, `openssl rand -base64 32`, DIFFERENT from ACCESS_CODES_KEY.
# Required in production (nothing is recorded or shown without it); development and tests fall back to a public
# development key. Keep it apart from the database and file backups. Rotation: new key here, the old one in
# IDENTITY_DOCS_PREVIOUS_KEYS, restart, `pnpm secrets:rotate`.
IDENTITY_DOCS_KEY=""
# IDENTITY_DOCS_PREVIOUS_KEYS="<old key in base64>,<older key>"
# Lot 7 (iCal sync): the test suites serve feeds from a local server and set CHANNELS_ALLOW_PRIVATE_URLS=1, which lets
# the app read http:// and private/loopback addresses. NEVER set it on a real server (it disables the SSRF protection).
# CHANNELS_ALLOW_PRIVATE_URLS="1"
# The background worker (`pnpm worker`, a process separate from `pnpm start`) uses the same DATABASE_URL and keys.
