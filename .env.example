# Postgres connection (docker compose up -d starts one matching this URL)
DATABASE_URL="postgresql://sigma:sigma@localhost:5432/sigma?schema=public"
# Session signing secret: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public origin of the app
BETTER_AUTH_URL="http://localhost:3000"
# Organization whose catalogue the public site shows (lib/server/org.ts); "sigma" when unset
SIGMA_ORG_SLUG="sigma"
# Where uploaded listing photos are stored (lib/storage/local.ts); ./uploads when unset
# UPLOAD_DIR="/var/lib/sigma/uploads"
# Outgoing e-mail/WhatsApp (lib/notifications): no provider yet. "console" prints messages in development only.
# NOTIFICATIONS_DRIVER="console"
